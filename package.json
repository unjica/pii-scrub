{
  "name": "@tacko/pii-scrub",
  "version": "0.1.1",
  "description": "Zero-dependency, best-effort scrubbing of emails, tokens, API keys, card numbers, phones and other secrets from logs, telemetry payloads and Error objects.",
  "license": "MIT",
  "author": "Sanja Malovic (https://github.com/unjica)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unjica/pii-scrub.git"
  },
  "bugs": "https://github.com/unjica/pii-scrub/issues",
  "homepage": "https://github.com/unjica/pii-scrub#readme",
  "keywords": [
    "pii",
    "redact",
    "redaction",
    "scrub",
    "sanitize",
    "logging",
    "telemetry",
    "privacy",
    "secrets",
    "mask"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:pack": "node scripts/pack-smoke.mjs",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "^22.10.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
